# Offline comparison, traceability, search, and reports work without any API key.
# Copy to .env for local use. NEVER commit a real .env or private credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep false locally to enable uploads, optional AI, and the LOCAL SQLite review log.
# For a publicly accessible Streamlit demo, set this to true in hosting secrets.
# This limits the app to fictional sample data: uploads, AI, and review writes are disabled.
CHANGEPILOT_PUBLIC_DEMO=false
